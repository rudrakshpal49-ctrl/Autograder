{
  "problem": "readability_demo",
  "time_limit_s": 1,
  "memory_limit_mb": 64,
  "metrics": [
    {
      "name": "syntax",
      "analyzer": "compiler_warnings",
      "weight": 0.25,
      "params": {"max_warnings": 0, "penalty_per_warning": 0.1}
    },
    {
      "name": "structure",
      "analyzer": "static_analysis",
      "weight": 0.25,
      "params": {"max_cyclomatic": 8, "max_function_length": 40, "penalty_per_violation": 0.1}
    },
    {
      "name": "modularity",
      "analyzer": "function_split",
      "weight": 0.25,
      "params": {"expect_helpers": false, "min_functions": 1, "penalty_per_missing_function": 0.3}
    },
    {
      "name": "readability",
      "analyzer": "llm_review",
      "weight": 0.25,
      "params": {
        "max_line_length": 100,
        "penalty_per_issue": 0.05,
        "require_comments": false,
        "use_llm": true,
        "model": "qwen2.5-coder:3b"
      }
    }
  ]
}

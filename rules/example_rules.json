{
  "problem": "example_assignment",
  "time_limit_s": 1,
  "memory_limit_mb": 64,
  "metrics": [
    {
      "name": "correctness",
      "analyzer": "io_tests",
      "weight": 0.2,
      "params": {
        "testset_source": "approved_assignment_tests"
      }
    },
    {
      "name": "syntax",
      "analyzer": "compiler_warnings",
      "weight": 0.1,
      "params": {
        "flags": "-Wall -Wextra -std=c11"
      }
    },
    {
      "name": "structure",
      "analyzer": "static_analysis",
      "weight": 0.1,
      "params": {
        "max_cyclomatic": 8,
        "max_function_nloc": 40
      }
    },
    {
      "name": "modularity",
      "analyzer": "function_split",
      "weight": 0.1,
      "params": {
        "mode": "auto",
        "suggest_if_ccn_over": 10,
        "suggest_if_nloc_over": 60
      }
    },
    {
      "name": "logical",
      "analyzer": "edge_case_runner",
      "weight": 0.1,
      "params": {
        "cases": [
          "negatives",
          "zero",
          "int_overflow"
        ]
      }
    },
    {
      "name": "complexity",
      "analyzer": "complexity_estimator",
      "weight": 0.1,
      "params": {
        "required": "O(n)",
        "sizes": [
          10,
          100,
          1000
        ]
      }
    },
    {
      "name": "memory_safety",
      "analyzer": "sanitizer_run",
      "weight": 0.1,
      "params": {
        "flags": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "readability",
      "analyzer": "llm_review",
      "weight": 0.1,
      "params": {
        "temperature": 0,
        "seed": 42
      }
    },
    {
      "name": "originality",
      "analyzer": "similarity_flag",
      "weight": 0.1,
      "params": {
        "flag_threshold": 0.85
      }
    }
  ]
}
